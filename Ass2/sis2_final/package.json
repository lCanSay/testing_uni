{
  "name": "toolshop-playwright-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript tests for Practice Software Testing (Toolshop v5.0)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
